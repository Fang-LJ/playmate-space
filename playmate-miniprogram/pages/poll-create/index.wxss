.p1-edit-page { padding-bottom: calc(224rpx + env(safe-area-inset-bottom)); }
.p1-context-card { padding: 30rpx; border: 1rpx solid rgba(107, 175, 146, 0.36); border-radius: var(--pm-radius-card); background: linear-gradient(135deg, #e9f5ef, #fffdf4); box-shadow: var(--pm-shadow-soft); }
.context-eyebrow { margin-bottom: 10rpx; color: var(--pm-primary-dark); font-size: 23rpx; font-weight: 700; }
.target-selector-card { padding: 26rpx; }
.target-picker { position: relative; min-height: 104rpx; margin-top: 14rpx; padding: 20rpx 64rpx 20rpx 22rpx; border: 1rpx solid var(--pm-border); border-radius: 20rpx; box-sizing: border-box; background: var(--pm-bg-soft); }
.target-picker-main { color: var(--pm-text); font-size: 27rpx; font-weight: 700; line-height: 1.4; }
.target-picker.placeholder .target-picker-main { color: #9ca9a1; font-weight: 500; }
.target-picker-desc { margin-top: 6rpx; color: var(--pm-text-muted); font-size: 22rpx; line-height: 1.45; }
.target-picker-arrow { position: absolute; top: 50%; right: 24rpx; color: var(--pm-primary-dark); font-size: 30rpx; transform: translateY(-55%); }
.time-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.placeholder { color: #9ca9a1; }
.choice-row { display: flex; gap: 14rpx; }
.allow-modify-row { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; color: var(--pm-text-muted); font-size: 25rpx; }
.short-textarea { height: 132rpx; }
.poll-option-edit { display: flex; flex-direction: column; gap: 14rpx; padding: 22rpx; border: 1rpx solid var(--pm-border); border-radius: 22rpx; background: #fbfdfb; }
.error-card { color: var(--pm-danger); line-height: 1.6; }
.option-card-title { display: flex; align-items: center; justify-content: space-between; }
.option-secondary { min-height: 76rpx; font-size: 25rpx; }
.option-remove { color: var(--pm-danger); font-size: 24rpx; }
.p1-fixed-footer { position: fixed; z-index: 10; left: 0; right: 0; bottom: 0; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--pm-border); background: rgba(246, 248, 245, 0.96); }
.poll-create-actions { display: flex; flex-direction: row; align-items: center; }
.poll-create-action { flex: 1; min-width: 0; }
.poll-create-action-first { margin-right: 16rpx; }
.poll-create-action .pm-native-button { width: 100%; margin: 0; }
.poll-options-empty { margin-top: 18rpx; padding: 12rpx 0 4rpx; color: var(--pm-text-muted); font-size: 25rpx; line-height: 1.5; text-align: center; }
.plan-summary-card { display: flex; align-items: center; gap: 20rpx; margin-top: 20rpx; padding: 24rpx; border: 1rpx solid var(--pm-border); border-radius: 24rpx; background: #fbfdfb; }
.plan-summary-content { flex: 1; min-width: 0; }
.plan-summary-name { color: var(--pm-primary-dark); font-size: 24rpx; font-weight: 700; }
.plan-summary-title { margin-top: 8rpx; overflow: hidden; color: var(--pm-text); font-size: 29rpx; font-weight: 800; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.plan-summary-meta { margin-top: 8rpx; color: var(--pm-text-muted); font-size: 23rpx; line-height: 1.45; }
.plan-summary-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 14rpx; }
.plan-summary-edit { color: var(--pm-primary-dark); font-size: 24rpx; font-weight: 700; }

.plan-editor-mask { position: fixed; z-index: 100; top: 0; right: 0; bottom: 0; left: 0; }
.plan-editor-backdrop { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(21, 33, 27, 0.34); }
.plan-editor-sheet { position: absolute; top: 32rpx; right: 24rpx; bottom: 24rpx; left: 24rpx; overflow: hidden; border-radius: 38rpx; background: var(--pm-bg); box-shadow: 0 28rpx 80rpx rgba(21, 33, 27, 0.2); }
.plan-editor-header { position: absolute; z-index: 2; top: 0; right: 0; left: 0; display: flex; align-items: center; justify-content: space-between; min-height: 112rpx; box-sizing: border-box; padding: 24rpx 30rpx; border-bottom: 1rpx solid var(--pm-border); background: rgba(246, 248, 245, 0.97); }
.plan-editor-title { color: var(--pm-text); font-size: 32rpx; font-weight: 800; line-height: 1.4; }
.plan-editor-close { display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; color: var(--pm-text-muted); font-size: 42rpx; font-weight: 300; line-height: 1; }
.plan-editor-scroll { position: absolute; top: 112rpx; right: 0; bottom: calc(136rpx + env(safe-area-inset-bottom)); left: 0; }
.plan-editor-content { padding: 28rpx 26rpx 40rpx; }
.plan-form-card { margin-bottom: 24rpx; padding: 28rpx; border: 1rpx solid #d6e4db; border-radius: 32rpx; background: #ffffff; box-shadow: 0 12rpx 20rpx rgba(22, 53, 38, 0.07); }
.plan-form-title { margin-bottom: 20rpx; color: var(--pm-text); font-size: 31rpx; font-weight: 800; line-height: 1.45; }
.plan-field-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; }
.plan-form-field { min-width: 0; box-sizing: border-box; padding: 22rpx; border: 1rpx solid #d6e4db; border-radius: 26rpx; background: #ffffff; }
.plan-form-field.full { grid-column: 1 / -1; }
.plan-field-label { color: var(--pm-text-muted); font-size: 22rpx; line-height: 1.4; }
.plan-field-control { width: 100%; min-height: 44rpx; margin-top: 6rpx; box-sizing: border-box; color: var(--pm-text); font-size: 29rpx; font-weight: 500; line-height: 44rpx; }
.plan-field-control.placeholder { color: #9ca9a1; }
.plan-note-textarea { width: 100%; min-height: 146rpx; box-sizing: border-box; padding: 24rpx; border: 1rpx solid #d6e4db; border-radius: 26rpx; background: #ffffff; color: var(--pm-text); font-size: 27rpx; line-height: 1.55; }
.plan-editor-footer { position: absolute; z-index: 2; right: 0; bottom: 0; left: 0; display: flex; gap: 20rpx; padding: 22rpx 26rpx calc(22rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--pm-border); background: rgba(255, 255, 255, 0.97); }
.plan-editor-action { display: flex; flex: 1; align-items: center; justify-content: center; min-height: 84rpx; box-sizing: border-box; margin: 0; border-radius: 26rpx; font-size: 27rpx; font-weight: 700; line-height: 1; }
.plan-editor-action::after { border: 0; }
.plan-editor-action.secondary { border: 1rpx solid var(--pm-primary); background: #ffffff; color: var(--pm-primary-dark); }
.plan-editor-action.primary { border: 1rpx solid var(--pm-primary-dark); background: var(--pm-primary); color: #ffffff; }
