<view class="page form-page"><view class="hero"><view class="title">{{expenseId?'编辑账单':'记一笔费用'}}</view><view class="desc">记录本次活动消费，系统会自动计算分摊和结算。</view></view><view class="card"><view class="label">账单名称</view><input class="input" placeholder="例如：晚餐火锅" value="{{form.title}}" data-key="title" bindinput="input"/><view class="two"><view><view class="label">金额</view><input class="input" type="digit" placeholder="0.00" value="{{form.amount}}" data-key="amount" bindinput="input"/></view><view><view class="label">分类</view><picker range="{{categoryOptions}}" range-key="label" value="{{categoryIndex}}" bindchange="category"><view class="input">{{categoryOptions[categoryIndex].label}}</view></picker></view></view><view class="label">付款人</view><picker range="{{members}}" range-key="nickname" value="{{payerIndex}}" bindchange="payer"><view class="input">{{members.length ? members[payerIndex].nickname : '请选择付款人'}}</view></picker><view class="label">消费时间</view><input class="input" value="{{form.expenseTime}}" data-key="expenseTime" bindinput="input"/><view class="label">分摊方式</view><view class="chips"><view class="chip {{form.splitMode==='EQUAL'?'selected':''}}" data-mode="EQUAL" bindtap="mode">平均分摊</view><view class="chip {{form.splitMode==='CUSTOM'?'selected':''}}" data-mode="CUSTOM" bindtap="mode">自定义金额</view></view></view><view class="card"><view class="label">参与分摊成员</view><view wx:for="{{members}}" wx:key="userId" class="share-row"><view class="check {{form.shares[index].checked?'checked':''}}" data-index="{{index}}" bindtap="toggleShare">{{form.shares[index].checked?'✓':''}}</view><view class="share-name">{{item.nickname}}</view><input wx:if="{{form.splitMode==='CUSTOM'&&form.shares[index].checked}}" class="share-input" type="digit" placeholder="金额" value="{{form.shares[index].shareAmount}}" data-index="{{index}}" bindinput="shareAmount"/></view></view><view class="card"><view class="label">付款凭证（可选）</view><image wx:if="{{form.receiptUrl}}" class="receipt" src="{{form.receiptUrl}}" mode="aspectFill"/><view class="upload" bindtap="receipt">{{uploading?'上传中…':form.receiptUrl?'更换凭证':'+ 上传凭证'}}</view><view class="label">备注说明</view><textarea class="textarea" maxlength="512" placeholder="补充说明（可选）" value="{{form.description}}" data-key="description" bindinput="input"/></view><view class="bottom"><button class="cancel" bindtap="back">取消</button><button class="save" loading="{{saving}}" bindtap="submit">保存账单</button></view></view>
