<view class="page form-page">
  <view class="hero">
    <view class="title">{{expenseId ? '编辑账单' : '记一笔费用'}}</view>
    <view class="desc">记录共同消费，系统会根据分摊结果实时计算 AA。</view>
  </view>

  <view class="card form-card">
    <view class="label">账单名称</view>
    <input class="input" placeholder="例如：晚餐火锅" value="{{form.title}}" data-key="title" bindinput="input"/>
    <view class="two">
      <view>
        <view class="label">金额</view>
        <input class="input" type="digit" placeholder="0.00" value="{{form.amount}}" bindinput="amountInput"/>
      </view>
      <view>
        <view class="label">分类</view>
        <picker range="{{categoryOptions}}" range-key="label" value="{{categoryIndex}}" bindchange="category">
          <view class="input picker-value">{{categoryOptions[categoryIndex].label}}</view>
        </picker>
      </view>
    </view>

    <view class="label">付款人</view>
    <picker wx:if="{{isCreator}}" range="{{members}}" range-key="nickname" value="{{payerIndex}}" bindchange="payer">
      <view class="input picker-value">{{members.length ? members[payerIndex].nickname : '请选择付款人'}}</view>
    </picker>
    <view wx:else class="payer-readonly">我</view>

    <view class="label">消费时间</view>
    <view class="two">
      <picker mode="date" value="{{expenseDate}}" bindchange="dateChange">
        <view class="input picker-value">{{expenseDate}}</view>
      </picker>
      <picker mode="time" value="{{expenseClock}}" bindchange="timeChange">
        <view class="input picker-value">{{expenseClock}}</view>
      </picker>
    </view>

    <view class="label">分摊方式</view>
    <view class="chips">
      <view class="chip {{form.splitMode==='EQUAL'?'selected':''}}" data-mode="EQUAL" bindtap="mode">平均分摊</view>
      <view class="chip {{form.splitMode==='CUSTOM'?'selected':''}}" data-mode="CUSTOM" bindtap="mode">自定义金额</view>
    </view>
  </view>

  <view class="card">
    <view class="share-heading">
      <view class="label">参与分摊成员</view>
      <view wx:if="{{form.splitMode==='CUSTOM'}}" class="allocation {{allocationBalanced?'balanced':''}}">已分配 ¥{{allocatedAmount}} / ¥{{form.amount || '0.00'}}</view>
    </view>
    <view wx:for="{{members}}" wx:key="userId" class="share-row">
      <view class="check {{form.shares[index].checked?'checked':''}}" data-index="{{index}}" bindtap="toggleShare">{{form.shares[index].checked?'✓':''}}</view>
      <view class="share-name">{{item.nickname}}</view>
      <input wx:if="{{form.splitMode==='CUSTOM'&&form.shares[index].checked}}" class="share-input" type="digit" placeholder="0.00" value="{{form.shares[index].shareAmount}}" data-index="{{index}}" bindinput="shareAmount"/>
    </view>
  </view>

  <view class="optional-trigger" bindtap="toggleOptional">
    <text>{{optionalExpanded ? '收起凭证和备注' : '+ 添加凭证和备注'}}</text>
    <text>{{optionalExpanded ? '⌃' : '⌄'}}</text>
  </view>
  <view wx:if="{{optionalExpanded}}" class="card optional-card">
    <view class="label">付款凭证</view>
    <image wx:if="{{form.receiptUrl}}" class="receipt" src="{{form.receiptUrl}}" mode="aspectFill"/>
    <view class="upload" bindtap="receipt">{{uploading ? '上传中…' : form.receiptUrl ? '更换凭证' : '+ 上传凭证'}}</view>
    <view class="label notes-label">备注说明</view>
    <textarea class="textarea" maxlength="512" placeholder="补充说明（可选）" value="{{form.description}}" data-key="description" bindinput="input"/>
  </view>

  <view class="bottom">
    <button class="cancel" bindtap="back">取消</button>
    <button class="save" loading="{{saving}}" bindtap="submit">保存账单</button>
  </view>
</view>
