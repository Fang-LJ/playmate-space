.form-page{padding:26rpx 28rpx 180rpx}.hero{padding:12rpx 4rpx 24rpx}.title{font-size:46rpx;font-weight:900;color:#15211b}.desc{margin-top:10rpx;color:#65746b;font-size:25rpx;line-height:1.55}.card{margin-bottom:18rpx;padding:28rpx;border:1rpx solid #d5e7de;border-radius:28rpx;background:#fff;box-shadow:0 12rpx 26rpx rgba(47,111,94,.06)}.label{margin:12rpx 0;color:#15211b;font-size:26rpx;font-weight:800}.input,.textarea{box-sizing:border-box;width:100%;min-height:82rpx;padding:20rpx;border:1rpx solid #d5e7de;border-radius:18rpx;background:#f8fbf8;color:#15211b;font-size:27rpx}.picker-value{display:flex;align-items:center}.textarea{height:150rpx}.two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18rpx}.chips{display:flex;gap:16rpx}.chip{padding:14rpx 20rpx;border:1rpx solid #d5e7de;border-radius:18rpx;color:#2e7961;font-weight:700}.chip.selected{background:#e9f5ef;border-color:#68b596}.payer-readonly{display:flex;align-items:center;min-height:64rpx;padding:0 4rpx;color:#15211b;font-size:28rpx;font-weight:700}.share-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.allocation{color:#b16a2c;font-size:22rpx}.allocation.balanced{color:#2e7961}.share-row{display:flex;align-items:center;min-height:76rpx;border-bottom:1rpx solid #edf3ef}.share-row:last-child{border-bottom:0}.check{width:36rpx;height:36rpx;margin-right:16rpx;border:1rpx solid #b9ddce;border-radius:50%;color:#fff;text-align:center;line-height:36rpx}.check.checked{background:#68b596}.share-name{flex:1;font-size:27rpx}.share-input{width:170rpx;padding:12rpx 6rpx;border-bottom:1rpx solid #d5e7de;text-align:right}.optional-trigger{display:flex;align-items:center;justify-content:space-between;margin:4rpx 4rpx 18rpx;padding:22rpx 24rpx;border:1rpx dashed #b9ddce;border-radius:20rpx;color:#2e7961;font-size:25rpx;font-weight:700}.optional-card{animation:optional-in .16s ease-out}.notes-label{margin-top:24rpx}.upload{padding:24rpx;border:1rpx dashed #9dcdb9;border-radius:18rpx;color:#2e7961;text-align:center}.receipt{width:180rpx;height:180rpx;margin-bottom:16rpx;border-radius:16rpx}.bottom{display:flex;gap:20rpx;position:fixed;z-index:8;right:0;bottom:0;left:0;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));background:rgba(246,248,245,.96);box-shadow:0 -8rpx 20rpx rgba(47,111,94,.04)}.bottom button{flex:1;height:86rpx;line-height:86rpx;border-radius:22rpx;font-size:28rpx;font-weight:800}.bottom button:after{border:0}.cancel{border:1rpx solid #b9ddce;background:#fff;color:#2e7961}.save{background:#68b596;color:#fff}@keyframes optional-in{from{opacity:.4;transform:translateY(-8rpx)}to{opacity:1;transform:translateY(0)}}
