.form-page{padding:26rpx 28rpx 160rpx}.hero{padding:12rpx 4rpx 24rpx}.title{font-size:46rpx;font-weight:900;color:#15211b}.desc{margin-top:10rpx;color:#65746b;font-size:25rpx}.card{margin-bottom:18rpx;padding:28rpx;border:1rpx solid #d5e7de;border-radius:28rpx;background:#fff;box-shadow:0 12rpx 26rpx rgba(47,111,94,.06)}.label{margin:12rpx 0;color:#15211b;font-size:26rpx;font-weight:800}.input,.textarea{box-sizing:border-box;width:100%;min-height:82rpx;padding:20rpx;border:1rpx solid #d5e7de;border-radius:18rpx;background:#f8fbf8;color:#15211b;font-size:27rpx}.textarea{height:150rpx}.two{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.chips{display:flex;gap:16rpx}.chip{padding:14rpx 20rpx;border:1rpx solid #d5e7de;border-radius:18rpx;color:#2e7961;font-weight:700}.chip.selected{background:#e9f5ef;border-color:#68b596}.share-row{display:flex;align-items:center;min-height:70rpx;border-bottom:1rpx solid #edf3ef}.check{width:36rpx;height:36rpx;margin-right:16rpx;border:1rpx solid #b9ddce;border-radius:50%;color:#fff;text-align:center;line-height:36rpx}.check.checked{background:#68b596}.share-name{flex:1;font-size:27rpx}.share-input{width:150rpx;padding:10rpx;border-bottom:1rpx solid #d5e7de;text-align:right}.upload{padding:24rpx;border:1rpx dashed #9dcdb9;border-radius:18rpx;color:#2e7961;text-align:center}.receipt{width:180rpx;height:180rpx;border-radius:16rpx}.bottom{display:flex;gap:20rpx;position:fixed;right:0;bottom:0;left:0;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));background:rgba(246,248,245,.96)}.bottom button{flex:1;height:86rpx;line-height:86rpx;border-radius:22rpx;font-size:28rpx;font-weight:800}.bottom button:after{border:0}.cancel{border:1rpx solid #b9ddce;background:#fff;color:#2e7961}.save{background:#68b596;color:#fff}
