<view class="page expense-page"><view wx:if="{{loading}}" class="card">正在加载费用…</view><view wx:elif="{{errorMessage}}" class="card">{{errorMessage}}</view><view wx:else><view class="card overview"><view class="eyebrow">活动总消费</view><view class="total">¥ {{summary.totalExpenseAmount}}</view><view class="summary-line">{{summary.activeExpenseCount}} 笔有效账单 · {{summary.pendingSettlementCount}} 笔待结算</view><view class="muted">已完成转账 ¥{{summary.completedSettlementAmount}}</view></view><view class="tabs"><view class="tab {{activeTab==='BILLS'?'active':''}}" data-tab="BILLS" bindtap="tab">账单</view><view class="tab {{activeTab==='MEMBERS'?'active':''}}" data-tab="MEMBERS" bindtap="tab">成员</view><view class="tab {{activeTab==='SETTLEMENTS'?'active':''}}" data-tab="SETTLEMENTS" bindtap="tab">结算</view></view><view wx:if="{{activeTab==='BILLS'}}"><scroll-view class="filters" scroll-x="true"><view wx:for="{{categories}}" wx:key="value" class="filter {{activeCategory===item.value?'selected':''}}" data-category="{{item.value}}" bindtap="category">{{item.label}}</view></scroll-view><view wx:if="{{!bills.length}}" class="card empty">还没有账单，记录第一笔消费吧。</view><view wx:for="{{bills}}" wx:key="expenseId" class="card bill" data-id="{{item.expenseId}}" bindtap="detail"><view><view class="bill-title">{{item.title}}</view><view class="muted">{{item.payerNickname}} 支付 · {{item.categoryText}}</view></view><view class="bill-right"><view>¥ {{item.amount}}</view><view wx:if="{{item.currentUserShareAmount!==null}}" class="muted">我分摊 ¥{{item.currentUserShareAmount}}</view></view></view></view><view wx:if="{{activeTab==='MEMBERS'}}"><view wx:for="{{members}}" wx:key="userId" class="card member"><image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" class="avatar" mode="aspectFill"/><view wx:else class="avatar">玩</view><view class="member-main"><view class="bill-title">{{item.nickname}}</view><view class="muted">已付 ¥{{item.paidAmount}} · 应承担 ¥{{item.shareAmount}}</view><view class="muted">已转出 ¥{{item.transferredOut}} · 已收到 ¥{{item.received}}</view></view><view class="member-net">{{item.settlementText}}</view></view></view><view wx:if="{{activeTab==='SETTLEMENTS'}}"><view class="card settlement-current"><view class="eyebrow">我的结算结果</view><view class="bill-title">{{summary.settlementText}}</view><view class="muted">待支付 ¥{{summary.pendingPayAmount}} · 待收款 ¥{{summary.pendingReceiveAmount}}</view></view><view wx:if="{{!settlements.length}}" class="card empty">目前无需结算</view><view wx:for="{{settlements}}" wx:key="fromUserId" class="card bill"><view><view class="bill-title">{{item.fromNickname}} → {{item.toNickname}}</view><view class="muted">建议线下转账</view></view><view class="bill-right"><view>¥ {{item.amount}}</view><button wx:if="{{item.currentUserCanComplete}}" class="small-button" data-item="{{item}}" bindtap="complete">我已转账</button></view></view><view wx:if="{{history.length}}" class="history-heading">转账历史</view><view wx:for="{{history}}" wx:key="settlementId" class="card bill"><view><view class="bill-title">{{item.fromNickname}} → {{item.toNickname}}</view><view class="muted">{{item.status==='COMPLETED'?'已完成':'已撤销'}}</view></view><view class="bill-right"><view>¥ {{item.amount}}</view><button wx:if="{{item.status==='COMPLETED'}}" class="small-button" data-item="{{item}}" bindtap="cancel">撤销标记</button></view></view><view class="calculation-note">{{summary.calculationRule}}</view></view><view class="bottom-safe"><button class="secondary-button" bindtap="create">记一笔</button><button class="primary-button" data-tab="SETTLEMENTS" bindtap="tab">费用结算</button></view></view></view>
