<view class="page expense-page">
  <view wx:if="{{loading}}" class="card">正在加载费用…</view>
  <view wx:elif="{{errorMessage}}" class="card">{{errorMessage}}</view>
  <view wx:else>
    <view class="card overview">
      <view class="eyebrow">活动总支出</view>
      <view class="total">¥{{summary.totalExpenseAmountText}}</view>
      <view class="overview-stats">
        <view class="overview-stat active-expense"><view class="overview-stat-label">账单</view><view class="overview-stat-value">{{summary.expenseCount}} 笔</view></view>
        <view class="overview-stat pending-settlement"><view class="overview-stat-label">转账建议</view><view class="overview-stat-value">{{summary.pendingSettlementCount}} 笔</view></view>
        <view class="overview-stat participant-count"><view class="overview-stat-label">参与成员</view><view class="overview-stat-value">{{summary.participantCount}} 人</view></view>
      </view>
    </view>
    <view class="tabs"><view class="tab {{activeTab==='BILLS'?'active':''}}" data-tab="BILLS" bindtap="tab">账单</view><view class="tab {{activeTab==='MEMBERS'?'active':''}}" data-tab="MEMBERS" bindtap="tab">成员</view><view class="tab {{activeTab==='SETTLEMENTS'?'active':''}}" data-tab="SETTLEMENTS" bindtap="tab">结算</view></view>
    <view wx:if="{{activeTab==='BILLS'}}">
      <view class="bill-section-head"><view class="section-title">消费记录</view><view class="bill-create" bindtap="create">+ 记一笔</view></view>
      <scroll-view class="filters" scroll-x="true"><view wx:for="{{categories}}" wx:key="value" class="filter {{activeCategory===item.value?'selected':''}}" data-category="{{item.value}}" bindtap="category">{{item.label}}</view></scroll-view>
      <view wx:if="{{!bills.length}}" class="card empty">还没有账单，记录第一笔消费吧。</view>
      <view wx:for="{{bills}}" wx:key="expenseId" class="card bill" data-id="{{item.expenseId}}" bindtap="detail">
        <view class="bill-top"><view class="bill-title">{{item.title}}</view><view class="bill-amount">¥{{item.amountText}}</view></view>
        <view class="bill-meta">{{item.categoryText}} · {{item.expenseTimeText}}</view>
        <view class="bill-bottom"><view class="bill-payer">{{item.payerSummary}}</view><view wx:if="{{item.currentUserShareAmount!==null}}" class="bill-share {{item.shareTone}}">我承担 ¥{{item.currentUserShareText}}</view></view>
      </view>
    </view>
    <view wx:if="{{activeTab==='MEMBERS'}}"><view wx:for="{{members}}" wx:key="userId" class="card member"><image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" class="avatar" mode="aspectFill"/><view wx:else class="avatar">玩</view><view class="member-main"><view class="bill-title">{{item.nickname}}</view><view class="member-amounts"><view><text class="muted">实际付款</text><text>¥{{item.paidAmount}}</text></view><view><text class="muted">应承担</text><text>¥{{item.shareAmount}}</text></view></view></view><view class="member-net">{{item.settlementText}}</view></view></view>
    <view wx:if="{{activeTab==='SETTLEMENTS'}}"><view class="section-title expense-section-title">结算建议</view><view wx:if="{{!suggestions.length}}" class="card empty">当前所有成员无需结算。</view><view wx:for="{{suggestions}}" wx:key="suggestionKey" class="card settlement-row"><view class="settlement-route"><view class="settlement-party"><image wx:if="{{item.fromAvatarUrl}}" src="{{item.fromAvatarUrl}}" class="settlement-avatar" mode="aspectFill"/><view wx:else class="settlement-avatar settlement-avatar-placeholder">{{item.fromAvatarText}}</view><view class="settlement-name">{{item.fromNickname}}</view></view><view class="settlement-arrow">→</view><view class="settlement-party"><image wx:if="{{item.toAvatarUrl}}" src="{{item.toAvatarUrl}}" class="settlement-avatar" mode="aspectFill"/><view wx:else class="settlement-avatar settlement-avatar-placeholder">{{item.toAvatarText}}</view><view class="settlement-name">{{item.toNickname}}</view></view></view><view class="bill-right">¥{{item.amountText}}</view></view><view class="calculation-note">{{dashboard.calculationRule}}</view></view>
  </view>
</view>
