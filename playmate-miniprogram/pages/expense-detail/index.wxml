<view class="page expense-page"><view wx:if="{{loading}}" class="card">正在加载费用…</view><view wx:elif="{{errorMessage}}" class="card">{{errorMessage}}</view><view wx:else><view class="card overview"><view class="eyebrow">活动总消费</view><view class="total">¥ {{summary.totalExpenseAmount}}</view><view class="summary-line">{{summary.expenseCount}} 笔账单 · {{summary.participantCount}} 人参与</view></view><view class="tabs"><view class="tab {{activeTab==='BILLS'?'active':''}}" data-tab="BILLS" bindtap="tab">账单</view><view class="tab {{activeTab==='MEMBERS'?'active':''}}" data-tab="MEMBERS" bindtap="tab">成员</view><view class="tab {{activeTab==='SETTLEMENTS'?'active':''}}" data-tab="SETTLEMENTS" bindtap="tab">结算</view></view><view wx:if="{{activeTab==='BILLS'}}"><scroll-view class="filters" scroll-x="true"><view wx:for="{{categories}}" wx:key="value" class="filter {{activeCategory===item.value?'selected':''}}" data-category="{{item.value}}" bindtap="category">{{item.label}}</view></scroll-view><view wx:if="{{!bills.length}}" class="card empty">还没有账单，记录第一笔消费吧。</view><view wx:for="{{bills}}" wx:key="expenseId" class="card bill" data-id="{{item.expenseId}}" bindtap="detail"><view><view class="bill-title">{{item.title}}</view><view class="muted">{{item.payerNickname}} 支付 · {{item.categoryText}}</view></view><view class="bill-right"><view>¥ {{item.amount}}</view><view wx:if="{{item.currentUserShareAmount!==null}}" class="muted">我承担 ¥{{item.currentUserShareAmount}}</view></view></view></view><view wx:if="{{activeTab==='MEMBERS'}}"><view wx:for="{{members}}" wx:key="userId" class="card member"><image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" class="avatar" mode="aspectFill"/><view wx:else class="avatar">玩</view><view class="member-main"><view class="bill-title">{{item.nickname}}</view><view class="member-amounts"><view><text class="muted">实际付款</text><text>¥{{item.paidAmount}}</text></view><view><text class="muted">应承担</text><text>¥{{item.shareAmount}}</text></view></view></view><view class="member-net">{{item.settlementText}}</view></view></view><view wx:if="{{activeTab==='SETTLEMENTS'}}"><view class="section-title expense-section-title">结算建议</view><view wx:if="{{!suggestions.length}}" class="card empty">当前所有成员无需结算。</view><view wx:for="{{suggestions}}" wx:key="fromUserId" class="card bill"><view class="bill-title">{{item.fromNickname}} → {{item.toNickname}}</view><view class="bill-right">¥ {{item.amount}}</view></view><view class="calculation-note">{{dashboard.calculationRule}}</view></view><view class="bottom-safe"><button class="primary-button" bindtap="create">记一笔</button></view></view></view>
