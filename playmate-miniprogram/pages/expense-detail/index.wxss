.expense-page{padding:24rpx 28rpx 180rpx}.card{box-sizing:border-box;margin-bottom:18rpx;padding:26rpx;border:1rpx solid #d5e7de;border-radius:28rpx;background:#fff;box-shadow:0 12rpx 26rpx rgba(47,111,94,.06)}.overview{background:linear-gradient(135deg,#e9f5ef,#fff)}.eyebrow,.muted,.summary-line,.calculation-note{color:#65746b;font-size:24rpx}.total{margin:8rpx 0;font-size:50rpx;font-weight:900;color:#15211b}.tabs{display:flex;padding:8rpx;margin:18rpx 0;border:1rpx solid #d5e7de;border-radius:22rpx;background:#fff}.tab{flex:1;padding:15rpx 4rpx;border-radius:16rpx;text-align:center;color:#2e7961;font-size:25rpx;font-weight:700}.tab.active{background:#68b596;color:#fff}.filters{white-space:nowrap;margin:0 0 18rpx}.filter{display:inline-block;margin-right:12rpx;padding:12rpx 22rpx;border:1rpx solid #d5e7de;border-radius:18rpx;background:#fff;color:#65746b;font-size:23rpx}.filter.selected{border-color:#68b596;background:#e9f5ef;color:#2e7961;font-weight:800}.bill,.member{display:flex;justify-content:space-between;align-items:center}.bill-title{font-size:29rpx;font-weight:800;color:#15211b}.bill-right{text-align:right;color:#2e7961;font-size:27rpx;font-weight:800}.small-button{margin:10rpx 0 0;padding:0 18rpx;height:46rpx;line-height:46rpx;border:1rpx solid #b9ddce;border-radius:14rpx;background:#fff;color:#2e7961;font-size:22rpx}.small-button:after,.primary-button:after,.secondary-button:after{border:0}.avatar{width:68rpx;height:68rpx;margin-right:18rpx;border-radius:50%;background:#e9f5ef;color:#2e7961;text-align:center;line-height:68rpx}.member-main{flex:1}.member-net{max-width:160rpx;color:#2e7961;font-size:25rpx;font-weight:700;text-align:right}.settlement-current{background:linear-gradient(135deg,#e9f5ef,#fff)}.history-heading{margin:28rpx 4rpx 16rpx;color:#15211b;font-size:29rpx;font-weight:800}.calculation-note{padding:8rpx 8rpx 24rpx;line-height:1.6}.empty{text-align:center;color:#65746b}.bottom-safe{display:flex;gap:18rpx;position:fixed;right:0;bottom:0;left:0;padding:20rpx 52rpx calc(20rpx + env(safe-area-inset-bottom));background:rgba(246,248,245,.96);box-shadow:0 -8rpx 20rpx rgba(47,111,94,.04)}.primary-button,.secondary-button{flex:1;height:86rpx;line-height:86rpx;border-radius:22rpx;font-size:29rpx;font-weight:800}.primary-button{background:#68b596;color:#fff}.secondary-button{border:1rpx solid #b9ddce;background:#fff;color:#2e7961}
