<view class="page photo-wall-page">
  <view wx:if="{{loading}}" class="card state-card">正在加载照片…</view>
  <view wx:elif="{{error&&!items.length}}" class="card state-card"><view>{{error}}</view><view class="pm-button-like secondary retry-button" bindtap="retry">重新加载</view></view>
  <block wx:else>
    <view class="photo-header"><view class="photo-header-title">活动照片</view><view class="photo-header-summary">{{summary.photoCount||0}} 张已展示</view><view class="photo-header-meta">我上传 {{summary.myUploadCount||0}} · 我的审核中 {{summary.pendingAuditCount||0}} · ♥ {{summary.receivedLikeCount||0}}</view></view>
    <view wx:if="{{summary.myUploadCount>0||summary.pendingAuditCount>0}}" class="my-uploads-row card" bindtap="openMineUploads"><view><view class="my-uploads-title">我的上传</view><view class="my-uploads-desc">审核中 {{summary.pendingAuditCount||0}} · 已上传 {{summary.myUploadCount||0}}</view></view><view class="my-uploads-link">查看 ›</view></view>
    <view class="browser-card card" bindtap="openTools"><view class="browser-title">浏览工具</view><view class="browser-controls"><view>筛选 <text>{{scope==='ALL'?'全部':scope==='MINE'?'我上传':'我点赞'}}⌄</text></view><view>排序 <text>{{sort==='LATEST'?'最新':sort==='EARLIEST'?'最早':'获赞最多'}}⌄</text></view><view>布局 <text>{{layout}}列⌄</text></view></view></view>
    <view wx:if="{{!items.length}}" class="card photo-empty"><view class="empty-icon">▧</view><view class="section-title">还没有照片</view><view class="section-desc">{{canUploadPhoto?'上传活动中的照片，审核通过后大家就能在这里看到。':'该活动已取消，照片墙仅供查看。'}}</view><view wx:if="{{canUploadPhoto}}" class="pm-button-like primary empty-upload" bindtap="chooseAndUpload">上传照片</view></view>
    <view wx:else class="photo-grid columns-{{layout}}"><view wx:for="{{items}}" wx:key="photoId" class="photo-tile scope-{{scope}}" data-id="{{item.photoId}}" bindtap="openPreview"><view class="tile-image-wrap"><image class="tile-image {{item.auditStatus==='REJECTED'?'rejected-image':''}}" src="{{item.thumbnailUrl}}" mode="aspectFill"/><view wx:if="{{item.auditStatus!=='APPROVED'||item.visibilityStatus==='REVIEWING'}}" class="audit-cover {{item.statusMeta.className}}">{{item.statusMeta.text}}</view></view><view wx:if="{{layout===2||scope==='MINE'}}" class="tile-info"><text class="tile-name">{{item.uploaderNickname||'玩伴用户'}}</text><text wx:if="{{scope==='MINE'}}" class="tile-status {{item.statusMeta.className}}">{{item.statusMeta.text}}</text><text wx:else class="tile-like">♥ {{item.likeCount||0}}</text><view wx:if="{{scope==='MINE'&&item.statusDescription}}" class="tile-status-desc">{{item.statusDescription}}</view></view></view></view>
    <view wx:if="{{loadingMore}}" class="load-more">正在加载更多…</view><view wx:elif="{{!hasMore&&items.length}}" class="load-more">已经到底啦</view><view wx:elif="{{error}}" class="load-more retry-more" bindtap="retry">加载失败，点击重试</view>
  </block>
  <view wx:if="{{canUploadPhoto}}" class="upload-fab pm-button-like primary" bindtap="chooseAndUpload">＋ 上传照片</view>
  <view wx:if="{{toolVisible}}" class="sheet-mask" bindtap="closeTools"><view class="tool-sheet" catchtap="stopPreviewClose"><view class="sheet-handle"></view><view class="sheet-title">浏览工具</view><view class="tool-group"><view class="tool-label">筛选范围</view><view class="tool-options"><view wx:for="{{['ALL','MINE','LIKED']}}" wx:key="*this" class="pm-chip {{draftScope===item?'active':''}}" data-value="{{item}}" bindtap="pickScope">{{item==='ALL'?'全部':item==='MINE'?'我上传':'我点赞'}}</view></view></view><view class="tool-group"><view class="tool-label">排序</view><view class="tool-options"><view wx:for="{{['LATEST','EARLIEST','MOST_LIKED']}}" wx:key="*this" class="pm-chip {{draftSort===item?'active':''}}" data-value="{{item}}" bindtap="pickSort">{{item==='LATEST'?'最新优先':item==='EARLIEST'?'最早优先':'获赞最多'}}</view></view></view><view class="tool-group"><view class="tool-label">布局</view><view class="tool-options"><view class="pm-chip {{draftLayout===3?'active':''}}" data-value="3" bindtap="pickLayout">3列</view><view class="pm-chip {{draftLayout===2?'active':''}}" data-value="2" bindtap="pickLayout">2列</view></view></view><view class="sheet-actions"><view class="pm-button-like secondary" bindtap="resetTools">重置</view><view class="pm-button-like primary" bindtap="applyTools">应用</view></view></view></view>
  <view wx:if="{{previewVisible}}" class="preview-mask" bindtap="closePreview"><view class="preview-close">×</view><image class="preview-image" src="{{previewPhoto.previewUrl}}" mode="aspectFit" catchtap="stopPreviewClose"/><view class="preview-card" catchtap="stopPreviewClose"><view class="preview-user"><image wx:if="{{previewPhoto.uploaderAvatarUrl}}" src="{{previewPhoto.uploaderAvatarUrl}}" class="preview-avatar" mode="aspectFill"/><view wx:else class="preview-avatar avatar-placeholder">{{previewPhoto.avatarText}}</view><view><view class="preview-name">{{previewPhoto.uploaderNickname||'玩伴用户'}}</view><view class="muted">{{previewPhoto.timeText}}</view></view></view><view class="preview-actions"><view wx:if="{{previewPhoto.auditStatus==='APPROVED'&&previewPhoto.visibilityStatus==='NORMAL'}}" class="pm-button-like secondary" bindtap="toggleLike">{{previewPhoto.likedByMe?'♥ 已点赞':'♡ 点赞'}} {{previewPhoto.likeCount||0}}</view><view class="pm-button-like primary" bindtap="goDetail">查看详情</view><view wx:if="{{previewPhoto.canDelete}}" class="preview-delete" bindtap="confirmDelete">删除</view></view></view></view>
  <view wx:if="{{uploadVisible}}" class="sheet-mask" bindtap="closeUpload"><view class="upload-sheet" catchtap="stopPreviewClose"><view class="sheet-handle"></view><view class="sheet-title">本次上传</view><view wx:if="{{uploadSummary}}" class="upload-summary">{{uploadSummary.done===uploadSummary.total&&uploadSummary.total?'照片已完成上传':uploadSummary.done+' 张已通过 · '+uploadSummary.pending+' 张审核中'}}<text wx:if="{{uploadSummary.rejected}}"> · {{uploadSummary.rejected}} 张未通过</text></view><view wx:for="{{uploadTasks}}" wx:key="id" class="upload-task"><image src="{{item.path}}" mode="aspectFill"/><view class="upload-status"><view>{{item.statusText}}</view><view wx:if="{{item.statusDescription}}" class="muted">{{item.statusDescription}}</view></view><view class="upload-chip {{item.statusTone}}">●</view></view><view class="pm-button-like secondary" bindtap="closeUpload">收起</view></view></view>
</view>
