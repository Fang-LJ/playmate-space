.photo-wall-page { padding-top:28rpx; padding-bottom:160rpx; }.state-card,.photo-empty { margin-top:24rpx; text-align:center; }.retry-button { width:220rpx; margin:24rpx auto 0; }
.photo-header { padding:4rpx 8rpx 20rpx; }.photo-header-title { color:var(--pm-text); font-size:38rpx; font-weight:900; }.photo-header-summary { margin-top:8rpx; color:var(--pm-primary-dark); font-size:28rpx; font-weight:800; }.photo-header-meta { margin-top:8rpx; color:var(--pm-text-muted); font-size:22rpx; }
.my-uploads-row { display:flex; align-items:center; justify-content:space-between; margin-top:6rpx; padding:20rpx 24rpx; }.my-uploads-title { color:var(--pm-text); font-size:26rpx; font-weight:800; }.my-uploads-desc { margin-top:4rpx; color:var(--pm-text-muted); font-size:21rpx; }.my-uploads-link { color:var(--pm-primary-dark); font-size:24rpx; font-weight:800; }
.browser-card { display:flex; align-items:center; justify-content:space-between; gap:14rpx; margin-top:16rpx; padding:18rpx 22rpx; }.browser-title { flex:0 0 auto; color:var(--pm-text); font-size:25rpx; font-weight:800; }.browser-controls { display:flex; flex:1; justify-content:flex-end; gap:8rpx; overflow:hidden; }.browser-controls view { min-width:0; padding:8rpx 10rpx; border:1rpx solid var(--pm-border); border-radius:14rpx; color:var(--pm-text-muted); font-size:18rpx; white-space:nowrap; }.browser-controls text { color:var(--pm-primary-dark); font-weight:700; }
.photo-empty { padding:64rpx 42rpx; }.empty-icon { margin-bottom:18rpx; color:var(--pm-primary); font-size:72rpx; line-height:1; }.empty-upload { width:240rpx; margin:30rpx auto 0; }
.photo-grid { display:grid; gap:14rpx; margin-top:22rpx; }.photo-grid.columns-3 { grid-template-columns:repeat(3,minmax(0,1fr)); }.photo-grid.columns-2 { grid-template-columns:repeat(2,minmax(0,1fr)); gap:20rpx; }.photo-tile { min-width:0; }.tile-image-wrap { position:relative; overflow:hidden; border-radius:20rpx; background:#dfe8e2; }.columns-3 .tile-image-wrap { height:220rpx; }.columns-2 .tile-image-wrap { height:326rpx; box-shadow:var(--pm-shadow-soft); }.tile-image { display:block; width:100%; height:100%; }.rejected-image { opacity:.42; filter:grayscale(70%); }.audit-cover { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(31,42,36,.45); color:#fff; font-size:24rpx; font-weight:800; }.audit-cover.rejected { background:rgba(217,76,76,.32); }.audit-cover.reviewing { background:rgba(242,184,75,.36); }.tile-info { display:flex; flex-wrap:wrap; align-items:center; gap:8rpx; min-width:0; padding:10rpx 4rpx 0; color:var(--pm-text-muted); font-size:20rpx; }.tile-name { flex:1; overflow:hidden; color:var(--pm-text); font-size:22rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }.tile-like { flex:0 0 auto; }.tile-status { flex:0 0 auto; font-weight:800; }.tile-status.pending,.tile-status.reviewing { color:#8a6500; }.tile-status.rejected { color:var(--pm-danger); }.tile-status.approved { color:var(--pm-primary-dark); }.tile-status-desc { flex-basis:100%; color:var(--pm-text-muted); font-size:18rpx; line-height:1.35; }.columns-3 .scope-ALL .tile-info,.columns-3 .scope-LIKED .tile-info { display:none; }
.load-more { padding:32rpx; color:var(--pm-text-muted); font-size:24rpx; text-align:center; }.retry-more { color:var(--pm-primary-dark); }.upload-fab { position:fixed; z-index:8; right:32rpx; bottom:calc(env(safe-area-inset-bottom) + 26rpx); min-width:208rpx; }
.sheet-mask,.preview-mask { position:fixed; z-index:40; inset:0; background:rgba(21,31,25,.46); }.tool-sheet,.upload-sheet { position:absolute; right:0; bottom:0; left:0; box-sizing:border-box; padding:18rpx 32rpx calc(34rpx + env(safe-area-inset-bottom)); border-radius:30rpx 30rpx 0 0; background:#fff; }.sheet-handle { width:64rpx; height:7rpx; margin:0 auto 20rpx; border-radius:999rpx; background:#dce5df; }.sheet-title { color:var(--pm-text); font-size:33rpx; font-weight:900; }.tool-group { margin-top:30rpx; }.tool-label { color:var(--pm-text); font-size:25rpx; font-weight:800; }.tool-options { display:flex; flex-wrap:wrap; gap:14rpx; margin-top:16rpx; }.sheet-actions { display:flex; gap:18rpx; margin-top:38rpx; }.sheet-actions view { flex:1; }
.preview-mask { z-index:50; display:flex; flex-direction:column; justify-content:center; }.preview-close { position:absolute; z-index:2; top:calc(env(safe-area-inset-top) + 28rpx); right:30rpx; width:64rpx; height:64rpx; border-radius:50%; background:rgba(255,255,255,.18); color:#fff; font-size:52rpx; line-height:57rpx; text-align:center; }.preview-image { width:100%; height:72vh; }.preview-card { position:absolute; right:24rpx; bottom:calc(env(safe-area-inset-bottom) + 20rpx); left:24rpx; padding:24rpx; border-radius:26rpx; background:#fff; }.preview-user { display:flex; align-items:center; gap:16rpx; }.preview-avatar { width:58rpx; height:58rpx; border-radius:50%; background:var(--pm-primary-light); }.avatar-placeholder { display:flex; align-items:center; justify-content:center; color:var(--pm-primary-dark); font-size:24rpx; font-weight:800; }.preview-name { color:var(--pm-text); font-size:27rpx; font-weight:800; }.preview-actions { display:flex; align-items:center; gap:14rpx; margin-top:24rpx; }.preview-actions .pm-button-like { flex:1; padding:0 14rpx; font-size:23rpx; }.preview-delete { padding:12rpx 6rpx; color:var(--pm-danger); font-size:23rpx; font-weight:800; white-space:nowrap; }
.upload-sheet { max-height:65vh; overflow:auto; }.upload-summary { margin-top:10rpx; color:var(--pm-text-muted); font-size:23rpx; }.upload-summary text { color:var(--pm-danger); }.upload-task { display:flex; align-items:center; gap:16rpx; min-height:92rpx; padding:14rpx 0; border-bottom:1rpx solid var(--pm-border); }.upload-task image { width:74rpx; height:74rpx; border-radius:14rpx; background:var(--pm-bg-soft); }.upload-status { flex:1; min-width:0; color:var(--pm-text); font-size:25rpx; }.upload-chip { flex:0 0 auto; color:var(--pm-warning); font-size:30rpx; }.upload-chip.approved { color:var(--pm-primary); }.upload-chip.rejected,.upload-chip.failed { color:var(--pm-danger); }.upload-chip.reviewing { color:#8a6500; }
