.activity-detail-page { padding-top: 18rpx; padding-bottom: 72rpx; }
.hero-section { margin-top: 12rpx; }
.activity-space-card {
  position: relative;
  overflow: hidden;
  min-height: 310rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(107, 175, 146, 0.28);
  border-radius: 30rpx;
  background: linear-gradient(135deg, #e9f5ef 0%, #f6f8f5 62%, #f4e7b4 100%);
  box-shadow: var(--pm-shadow-card);
}

.cover-layer { position: absolute; z-index: 0; top: 0; right: 0; bottom: 0; left: 0; overflow: hidden; }
.space-cover { display: block; width: 100%; height: 100%; }
.cover-scrim { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(112deg, rgba(246, 248, 245, 0.86) 0%, rgba(246, 248, 245, 0.7) 48%, rgba(246, 248, 245, 0.42) 100%); }
.default-hero { background: radial-gradient(circle at 60% 35%, #f2b84b 0 22rpx, transparent 24rpx), linear-gradient(145deg, #e9f5ef 0%, #f6f8f5 52%, #f4e7b4 100%); }
.space-content { position: relative; z-index: 2; padding: 34rpx; }
.activity-action-anchor { position: absolute; top: 24rpx; right: 24rpx; z-index: 12; }
.activity-action-trigger { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; color: var(--pm-primary-dark); font-size: 29rpx; font-weight: 900; letter-spacing: 2rpx; text-shadow: 0 2rpx 8rpx rgba(255, 255, 255, 0.75); }
.activity-action-menu { position: absolute; top: 70rpx; right: 0; width: 188rpx; padding: 8rpx; border: 1rpx solid var(--pm-border); border-radius: 18rpx; background: #fff; box-shadow: 0 18rpx 36rpx rgba(47, 111, 94, 0.16); }
.activity-action-item { display: flex; align-items: center; gap: 12rpx; min-height: 58rpx; padding: 0 12rpx; border-radius: 12rpx; color: var(--pm-text); font-size: 24rpx; font-weight: 700; }
.activity-action-item:active { background: var(--pm-primary-light); }
.activity-action-item.danger { color: var(--pm-danger); }
.activity-action-item.danger:active { background: var(--pm-danger-soft); }
.activity-action-icon { display: inline-flex; align-items: center; justify-content: center; width: 30rpx; color: currentColor; font-size: 32rpx; line-height: 1; }
.activity-action-mask { position: fixed; z-index: 10; top: 0; right: 0; bottom: 0; left: 0; background: transparent; }
.activity-name { margin-top: 18rpx; color: var(--pm-text); font-size: 43rpx; font-weight: 900; line-height: 1.22; }
.activity-meta { margin-top: 10rpx; color: var(--pm-text-muted); font-size: 26rpx; line-height: 1.45; }
.activity-desc { margin-top: 18rpx; max-width: 520rpx; color: var(--pm-text-muted); font-size: 26rpx; line-height: 1.55; }
.share-row { display: flex; gap: 18rpx; margin-top: 24rpx; }
.share-button { min-width: 168rpx; height: 62rpx; font-size: 26rpx; }
.share-button.secondary { margin: 0; line-height: 62rpx; }
.share-button.secondary::after { border: 0; }

.member-card { padding: 24rpx 28rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; }
.link-text { color: var(--pm-text-muted); font-size: 24rpx; font-weight: 700; }
.member-strip { display: flex; align-items: center; margin-top: 18rpx; }
.member-avatar { width: 56rpx; height: 56rpx; margin-right: -8rpx; border: 4rpx solid #fff; border-radius: 50%; background: var(--pm-primary-light); }
.member-avatar-placeholder { display: flex; align-items: center; justify-content: center; color: var(--pm-primary-dark); font-size: 22rpx; font-weight: 800; }
.member-count { margin-left: auto; color: var(--pm-text-muted); font-size: 25rpx; }

.todo-card { padding: 26rpx; border: 1rpx solid #f3e19a; border-radius: 28rpx; background: #fff9e6; box-shadow: var(--pm-shadow-soft); }
.todo-line { margin-top: 12rpx; font-size: 25rpx; color: var(--pm-text); }
.tab-bar { display: grid; grid-template-columns: repeat(4, 1fr); padding: 8rpx; border: 1rpx solid var(--pm-border); border-radius: 24rpx; background: #fff; }
.tab { padding: 16rpx 4rpx; border-radius: 18rpx; text-align: center; color: var(--pm-primary-dark); font-size: 23rpx; font-weight: 700; }
.tab.active { background: var(--pm-primary); color: #fff; }
.section-head { display: flex; align-items: center; justify-content: space-between; }
.section-icon-actions { display: flex; align-items: center; gap: 14rpx; }
.section-icon-button { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; color: var(--pm-primary-dark); }
.section-icon-button:active { opacity: 0.58; }
.section-add-icon { font-size: 39rpx; font-weight: 500; line-height: 1; }
.section-list-icon { font-size: 32rpx; font-weight: 700; line-height: 1; }
.itinerary-card-list { display: flex; flex-direction: column; gap: 20rpx; margin-top: 20rpx; }
.compact-row { display: flex; gap: 18rpx; align-items: flex-start; margin-top: 14rpx; padding: 22rpx; font-size: 25rpx; }
.row-main { flex: 1; }
.row-title { font-weight: 800; }
.review { color: #8a6500; font-size: 23rpx; }
.empty-card { margin-top: 16rpx; }
.cost-summary-card { position: relative; padding: 38rpx 28rpx 42rpx; background: #fff; }
.cost-summary-title { color: #2f6f5e; font-size: 23rpx; font-weight: 700; line-height: 1.35; }
.cost-settlement-headline { margin-top: 16rpx; color: #1f2a24; font-size: 34rpx; font-weight: 900; line-height: 1.3; }
.cost-settlement-headline.pay,.cost-settlement-headline.receive { color: #1f2a24; }.cost-settlement-headline.balanced { color: #65746b; }
.cost-summary-stats { display: flex; gap: 14rpx; margin-top: 30rpx; }
.cost-summary-stat { flex: 1; min-width: 0; padding: 24rpx 16rpx 26rpx; border-radius: 16rpx; box-sizing: border-box; }
.cost-stat-label { overflow: hidden; color: #65746b; font-size: 23rpx; font-weight: 500; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.cost-stat-amount { margin-top: 14rpx; overflow: hidden; color: #1f2a24; font-size: 30rpx; font-weight: 800; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.pay-stat { background: #e6f5ee; }
.receive-stat { background: #fff4dc; }
.net-stat { background: #edf2ee; }
.expense-section-head { margin-top: 30rpx; padding: 0 26rpx; }
.expense-section-head .section-title { font-size: 28rpx; line-height: 1.35; }
.expense-preview { display:flex; align-items:center; justify-content:space-between; min-height:120rpx; margin-top:16rpx; padding:24rpx 26rpx; box-sizing:border-box; }
.settlement-card { display:flex; align-items:center; justify-content:space-between; min-height:128rpx; gap:24rpx; margin-top:16rpx; padding:30rpx 32rpx; box-sizing:border-box; }
.settlement-amount,.expense-amount { font-weight:900; }
.expense-amount { font-size:28rpx; }
.settlement-left { display:flex; flex:1; min-width:0; align-items:center; }
.settlement-route { display:flex; flex:1; min-width:0; align-items:center; gap:16rpx; }
.settlement-party { display:flex; min-width:0; align-items:center; gap:14rpx; }
.settlement-avatar { flex:0 0 56rpx; width:56rpx; height:56rpx; border-radius:50%; background:var(--pm-primary-light); box-sizing:border-box; }
.settlement-avatar-placeholder { display: flex; align-items: center; justify-content: center; color: var(--pm-primary-dark); font-size: 24rpx; font-weight: 800; }
.settlement-name { overflow:hidden; min-width:0; max-width:144rpx; color:var(--pm-text); font-size:28rpx; font-weight:800; line-height:1.25; white-space:nowrap; text-overflow:ellipsis; }
.settlement-arrow { flex:0 0 auto; color:var(--pm-text-muted); font-size:32rpx; font-weight:700; line-height:1; text-align:center; }
.settlement-right { display:flex; flex:0 0 auto; min-width:150rpx; align-items:flex-end; justify-content:center; flex-direction:column; }
.settlement-status { font-size:21rpx; font-weight:500; line-height:1.2; }
.settlement-status.outbound { color:#9c8167; }
.settlement-status.inbound { color:#6f8e80; }
.settlement-amount { margin-top:10rpx; font-size:33rpx; font-weight:900; line-height:1; white-space:nowrap; }
.settlement-amount.outbound { color:#b86d24; }
.settlement-amount.inbound { color:var(--pm-primary-dark); }
.cost-add { width: 310rpx; margin: 30rpx auto 0; }
.photo-module { padding-bottom: 30rpx; }.photo-retry { width: 200rpx; margin: 18rpx auto 0; }.recent-photo-swiper-wrap { position:relative; margin-top:18rpx; overflow:hidden; border-radius:24rpx; background:#e5ece7; }.recent-photo-swiper { height:390rpx; }.recent-photo-stage { display:flex; align-items:center; justify-content:center; width:100%; height:100%; }.recent-photo-stage image { width:100%; height:100%; }.recent-photo-arrow { position:absolute; z-index:2; top:50%; display:flex; align-items:center; justify-content:center; width:46rpx; height:46rpx; margin-top:-23rpx; border-radius:50%; background:rgba(31,42,36,.28); color:#fff; font-size:42rpx; line-height:1; }.recent-photo-arrow.previous { left:16rpx; }.recent-photo-arrow.next { right:16rpx; }.recent-photo-page { position:absolute; right:16rpx; bottom:14rpx; padding:6rpx 12rpx; border-radius:999rpx; background:rgba(31,42,36,.35); color:#fff; font-size:19rpx; }.photo-tab-empty { margin-top:16rpx; padding:52rpx 34rpx; text-align:center; }.photo-empty-glyph { margin-bottom:14rpx; color:var(--pm-primary); font-size:60rpx; }.photo-empty-upload { width:220rpx; margin:26rpx auto 0; }.photo-status-card { margin-top:22rpx; padding:28rpx; }.photo-status-heading { color:var(--pm-text); font-size:26rpx; font-weight:800; }.photo-status-primary { margin-top:14rpx; color:var(--pm-text); font-size:38rpx; font-weight:900; }.photo-status-primary text { font-size:24rpx; font-weight:700; }.photo-status-subrow { display:flex; gap:24rpx; margin-top:18rpx; color:var(--pm-text-muted); font-size:23rpx; }.photo-status-subrow text { color:var(--pm-text); font-size:25rpx; font-weight:800; }.photo-audit-notice { display:flex; align-items:center; gap:10rpx; margin-top:20rpx; padding:16rpx; border-radius:16rpx; background:var(--pm-warning-soft); color:#8a6500; font-size:22rpx; }.photo-audit-notice text { flex:1; }.photo-audit-link { color:var(--pm-primary-dark); font-weight:800; }.photo-tab-actions { display:flex; gap:16rpx; margin-top:24rpx; }.photo-tab-actions view { flex:1; }
.expense-right { text-align:right; }.my-share { margin-top:6rpx; color:var(--pm-primary-dark); font-size:21rpx; }.cost-actions { display:flex; gap:18rpx; }.cost-actions-fixed { position:fixed; z-index:20; right:32rpx; bottom:calc(env(safe-area-inset-bottom) + 20rpx); left:32rpx; padding:20rpx 0; background:linear-gradient(to bottom, rgba(246,248,245,0), var(--pm-bg) 28rpx); }.cost-overview { padding-bottom:158rpx; }.cost-action { flex:1; text-align:center; }.expense-empty { margin-top:16rpx; padding:30rpx; text-align:center; }.empty-expense-button { width:220rpx; margin:24rpx auto 0; }
