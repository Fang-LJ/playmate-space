<view class="page p1-edit-page">
  <view class="page-title">{{itineraryId ? '编辑行程' : '新增行程'}}</view>

  <view wx:if="{{loading}}" class="section card">正在加载行程类型…</view>
  <view wx:elif="{{metadataError}}" class="section card stack">
    <view>{{metadataError}}</view>
    <button class="pm-native-button primary" bindtap="retryMetadata">重新加载</button>
  </view>

  <block wx:else>
    <view class="page-subtitle">{{typeCopy}}</view>

    <view class="type-strip">
      <view
        wx:for="{{types}}"
        wx:key="value"
        class="type-chip {{item.themeClass}} {{form.itineraryType === item.value ? 'active' : ''}}"
        data-type="{{item.value}}"
        bindtap="pickType"
      >{{item.label}}</view>
    </view>

    <view wx:if="{{needsTimeCompletion}}" class="time-completion-tip">这是一条历史全天行程，请补充开始和结束时间后再保存。</view>

    <view class="section form-section-card">
      <view class="field-grid">
        <block wx:for="{{formView.commonFields}}" wx:key="key">
          <view class="form-field {{item.layoutClass}}">
            <view class="field-label">{{item.label}}</view>
            <picker wx:if="{{item.control === 'date'}}" mode="date" value="{{item.value}}" data-key="{{item.key}}" bindchange="pickFormValue">
              <view class="field-control {{item.value ? '' : 'placeholder'}}">{{item.value || '选择日期'}}</view>
            </picker>
            <picker wx:elif="{{item.control === 'time'}}" mode="time" value="{{item.value}}" data-key="{{item.key}}" bindchange="pickFormValue">
              <view class="field-control {{item.value ? '' : 'placeholder'}}">{{item.value || '选择时间'}}</view>
            </picker>
            <input wx:else class="field-control" value="{{item.value}}" data-key="{{item.key}}" bindinput="input" placeholder="请输入{{item.label}}" />
          </view>
        </block>
        <view class="form-field half status-field">
          <view class="field-label">状态</view>
          <view class="field-control static-value">{{statusText}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{formView.arrangementFields.length}}" class="section form-section-card">
      <view class="form-section-title">{{formView.arrangementTitle}}</view>
      <view class="field-grid">
        <view wx:for="{{formView.arrangementFields}}" wx:key="key" class="form-field {{item.layoutClass}}">
          <view class="field-label">{{item.label}}</view>
          <input class="field-control {{index === 0 ? 'type-focus-control' : ''}}" value="{{item.value}}" data-key="{{item.key}}" bindinput="input" placeholder="请输入{{item.label}}" />
        </view>
      </view>
    </view>

    <view wx:if="{{formView.descriptionField}}" class="section form-section-card note-form-card">
      <view class="form-section-title">备注说明</view>
      <textarea
        class="note-textarea"
        value="{{formView.descriptionField.value}}"
        data-key="description"
        bindinput="input"
        placeholder="补充集合要求、路线、预约或其他说明"
      />
    </view>

    <view class="p1-fixed-footer">
      <button class="footer-action secondary" bindtap="cancel">取消</button>
      <button class="footer-action primary" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存行程</button>
    </view>
  </block>
</view>
