.detail-page{padding:28rpx 28rpx 168rpx}.card{box-sizing:border-box;margin-bottom:22rpx;padding:30rpx;border:1rpx solid #d5e7de;border-radius:28rpx;background:#fff;box-shadow:0 12rpx 26rpx rgba(47,111,94,.06)}.hero{padding:32rpx 30rpx;background:#f7f9f7}.hero-heading,.shares-heading,.info-row,.share{display:flex;align-items:center}.hero-heading,.shares-heading,.info-row{justify-content:space-between;gap:20rpx}.title,.heading{color:#15211b;font-size:31rpx;font-weight:900;line-height:1.35}.hero-heading .title{min-width:0;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.category-tag{flex:0 0 auto;padding:7rpx 17rpx;border-radius:999rpx;font-size:21rpx;font-weight:800;line-height:1.25}.amount{margin:22rpx 0 12rpx;color:#15211b;font-size:52rpx;font-weight:900;line-height:1.1}.hero-meta{color:#6e7f75;font-size:23rpx;line-height:1.4}.void{margin-top:16rpx;color:#c85555;font-size:22rpx}.info-card{padding-top:28rpx}.info-card .heading{margin-bottom:20rpx}.info-row{min-height:42rpx;margin-top:10rpx;font-size:23rpx;line-height:1.4}.info-label{color:#7b8a82}.info-value{color:#25342d;font-weight:700;text-align:right}.shares-card{padding:28rpx 24rpx 22rpx}.shares-heading{padding:0 6rpx;margin-bottom:18rpx}.shares-total{color:#2e7961;font-size:22rpx;font-weight:800}.share{min-height:74rpx;padding:0 16rpx;margin-top:12rpx;border-radius:16rpx;background:#f4f7f5;gap:16rpx}.share.current-share{background:#e8f5ef}.share-avatar{width:46rpx;height:46rpx;flex:0 0 46rpx;border-radius:50%;background:#e5ece8}.share-avatar-placeholder{color:#58756a;font-size:21rpx;font-weight:800;text-align:center;line-height:46rpx}.share-name{min-width:0;flex:1;overflow:hidden;color:#25342d;font-size:24rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.share-amount{flex:0 0 auto;color:#25342d;font-size:23rpx;font-weight:800}.allocation-note{margin-top:14rpx;padding:16rpx;border-radius:14rpx;background:#fff4dc;color:#788177;font-size:20rpx;line-height:1.4}.attachment-card .heading,.note-card .heading{margin-bottom:16rpx}.receipt{width:100%;border-radius:18rpx}.note-content{color:#65746b;font-size:24rpx;line-height:1.6}.actions{position:fixed;right:0;bottom:0;left:0;display:flex;gap:18rpx;padding:20rpx 44rpx calc(20rpx + env(safe-area-inset-bottom));background:rgba(246,248,245,.96);box-shadow:0 -8rpx 20rpx rgba(47,111,94,.04)}.actions button{flex:1;height:82rpx;line-height:82rpx;border-radius:20rpx;font-size:27rpx;font-weight:800}.actions button:after{border:0}.edit{background:#68b596;color:#fff}.void-button{border:1rpx solid #f0c9c9;background:#fff;color:#d94c4c}.theme-food{border-color:#e8e4bb;background:#fbfaea}.theme-food .category-tag{background:#e7f4e9;color:#39805e}.theme-transport{border-color:#cfe2f2;background:#f0f8ff}.theme-transport .category-tag{background:#dceeff;color:#3d78a8}.theme-lodging{border-color:#ded4f2;background:#f7f3ff}.theme-lodging .category-tag{background:#ece5ff;color:#7657a8}.theme-ticket{border-color:#f3d7bb;background:#fff7ee}.theme-ticket .category-tag{background:#ffead5;color:#b56d2e}.theme-entertainment{border-color:#f1cdd9;background:#fff4f7}.theme-entertainment .category-tag{background:#fbe4ec;color:#ad5b78}.theme-shopping{border-color:#c9e4e8;background:#f1fbfc}.theme-shopping .category-tag{background:#def3f5;color:#3a7f88}.theme-other{border-color:#dce4df;background:#f6f8f7}.theme-other .category-tag{background:#eaf0ec;color:#65746b}
