.detail-page{padding:26rpx 28rpx 80rpx}.card{margin-bottom:18rpx;padding:28rpx;border:1rpx solid #d5e7de;border-radius:28rpx;background:#fff;box-shadow:0 12rpx 26rpx rgba(47,111,94,.06)}.hero{background:linear-gradient(135deg,#e9f5ef,#fff)}.tag{display:inline-block;padding:7rpx 15rpx;border-radius:14rpx;background:#e9f5ef;color:#2e7961;font-size:22rpx;font-weight:800}.amount{margin:18rpx 0 10rpx;font-size:52rpx;font-weight:900;color:#15211b}.title,.heading{font-size:31rpx;font-weight:900;color:#15211b}.muted{margin-top:8rpx;color:#65746b;font-size:25rpx;line-height:1.5}.void{margin-top:15rpx;color:#d94c4c}.share{display:flex;justify-content:space-between;padding:22rpx 0;border-bottom:1rpx solid #edf3ef;font-size:27rpx}.receipt{width:100%;margin-top:16rpx;border-radius:18rpx}.actions{display:flex;gap:20rpx;margin-top:30rpx}.actions button{flex:1;height:82rpx;line-height:82rpx;border-radius:20rpx;font-size:27rpx;font-weight:800}.actions button:after{border:0}.edit{border:1rpx solid #b9ddce;background:#fff;color:#2e7961}.void-button{border:1rpx solid #f0c9c9;background:#fff;color:#d94c4c}
