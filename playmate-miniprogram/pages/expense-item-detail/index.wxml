<view class="page detail-page"><view wx:if="{{loading}}" class="card">正在加载账单…</view><view wx:elif="{{errorMessage}}" class="card">{{errorMessage}}</view><view wx:else><view class="card hero"><view class="tag">{{detail.categoryText}}</view><view class="amount">¥ {{detail.amount}}</view><view class="title">{{detail.title}}</view><view class="muted">{{detail.payerNickname}} 支付 · {{detail.expenseTime}}</view><view wx:if="{{detail.status==='VOID'}}" class="void">已作废 {{detail.voidReason}}</view></view><view class="card"><view class="heading">分摊明细</view><view wx:for="{{detail.shares}}" wx:key="userId" class="share"><view>{{item.nickname}}</view><view>¥ {{item.shareAmount}}</view></view></view><view wx:if="{{detail.receiptUrl}}" class="card"><view class="heading">付款凭证</view><image src="{{detail.receiptUrl}}" class="receipt" mode="widthFix"/></view><view wx:if="{{detail.description}}" class="card"><view class="heading">备注</view><view class="muted">{{detail.description}}</view></view><view wx:if="{{detail.status==='ACTIVE'}}" class="actions"><button class="edit" bindtap="edit">编辑账单</button><button class="void-button" bindtap="voidExpense">作废账单</button></view></view></view>
