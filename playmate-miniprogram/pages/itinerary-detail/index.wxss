.itinerary-detail-page {
  --type-bg: #f1f4f2;
  --type-border: #cdd8d1;
  --type-text: #66756c;
  padding: 36rpx 40rpx 72rpx;
}
.itinerary-detail-page .page-title { font-size: 56rpx; line-height: 82rpx; }

.itinerary-hero {
  position: relative;
  box-sizing: border-box;
  padding: 36rpx;
  border: 1rpx solid var(--type-border);
  border-radius: 36rpx;
  background: var(--type-bg);
  box-shadow: 0 14rpx 18rpx rgba(22, 53, 38, 0.1);
}

.itinerary-hero.transport { --type-bg: #eaf3ff; --type-border: #a9ccf2; --type-text: #357fc4; }
.itinerary-hero.meal { --type-bg: #fff3e4; --type-border: #f0c88e; --type-text: #b96d21; }
.itinerary-hero.lodging { --type-bg: #f3eeff; --type-border: #cdbcf3; --type-text: #7658b6; }
.itinerary-hero.sightseeing { --type-bg: #e8f7f3; --type-border: #a5d9cb; --type-text: #2d8972; }
.itinerary-hero.activity { --type-bg: #fff0f4; --type-border: #e7b4c2; --type-text: #b15070; }

.itinerary-hero-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding-right: 56rpx; }
.itinerary-type { color: var(--type-text); font-size: 24rpx; font-weight: 700; line-height: 34rpx; }
.itinerary-status { display: inline-flex; align-items: center; min-height: 52rpx; padding: 0 20rpx; border: 1rpx solid #55ae84; border-radius: 999rpx; background: #eaf6f0; color: #3f9872; font-size: 22rpx; font-weight: 600; }
.itinerary-status.pending_decision,
.itinerary-status.draft { border-color: #e9c85b; background: #fff6d9; color: #866700; }
.itinerary-status.canceled { border-color: #cdd8d1; background: #f1f4f2; color: #66756c; }
.itinerary-hero-title { margin-top: 16rpx; color: #16231b; font-size: 44rpx; font-weight: 800; line-height: 64rpx; }
.itinerary-hero-date { margin-top: 4rpx; color: #66756c; font-size: 26rpx; line-height: 38rpx; }
.itinerary-summary { margin-top: 12rpx; color: #16231b; font-size: 30rpx; font-weight: 600; line-height: 44rpx; }

.detail-card { display: flex; flex-direction: column; gap: 28rpx; padding: 32rpx; border-color: #d6e4db; border-radius: 36rpx; box-shadow: 0 14rpx 18rpx rgba(22, 53, 38, 0.1); }
.detail-card.transport { --type-text: #357fc4; }
.detail-card.meal { --type-text: #b96d21; }
.detail-card.lodging { --type-text: #7658b6; }
.detail-card.sightseeing { --type-text: #2d8972; }
.detail-card.activity { --type-text: #b15070; }
.detail-heading { color: #16231b; font-size: 36rpx; font-weight: 800; line-height: 52rpx; }
.detail-row { display: grid; grid-template-columns: 176rpx minmax(0, 1fr); gap: 24rpx; align-items: start; }
.detail-label { color: #66756c; font-size: 24rpx; line-height: 34rpx; }
.detail-value { min-width: 0; overflow-wrap: anywhere; color: #16231b; font-size: 28rpx; font-weight: 500; line-height: 40rpx; }
.detail-emphasis { color: var(--type-text); font-weight: 700; }
.note-card { display: flex; flex-direction: column; gap: 16rpx; padding: 32rpx; border-color: #d6e4db; border-radius: 36rpx; box-shadow: 0 14rpx 18rpx rgba(22, 53, 38, 0.1); }
.note-copy { color: #66756c; font-size: 28rpx; line-height: 40rpx; white-space: pre-wrap; }
.poll-row { margin-top: 14rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; font-size: 27rpx; }
.poll-main { flex: 1; min-width: 0; }
.poll-arrow { color: var(--pm-text-muted); font-size: 36rpx; }
.applied-summary { margin-top: 10rpx; color: var(--pm-primary-dark); font-size: 22rpx; line-height: 1.45; }
.itinerary-action-anchor { position: absolute; top: 20rpx; right: 20rpx; z-index: 12; }
.itinerary-action-trigger { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; color: var(--pm-primary-dark); font-size: 29rpx; font-weight: 900; letter-spacing: 2rpx; }
.itinerary-action-menu { position: absolute; top: 70rpx; right: 0; width: 190rpx; padding: 8rpx; border: 1rpx solid var(--pm-border); border-radius: 18rpx; background: #fff; box-shadow: 0 18rpx 36rpx rgba(47, 111, 94, 0.16); }
.itinerary-action-item { display: flex; align-items: center; gap: 12rpx; min-height: 58rpx; padding: 0 12rpx; border-radius: 12rpx; color: var(--pm-text); font-size: 24rpx; font-weight: 700; }
.itinerary-action-item:active { background: var(--pm-primary-light); }
.itinerary-action-item.warning { color: #9a7000; }
.itinerary-action-item.danger { color: var(--pm-danger); }
.itinerary-action-item.danger:active { background: var(--pm-danger-soft); }
.itinerary-action-icon { display: inline-flex; align-items: center; justify-content: center; width: 30rpx; color: currentColor; font-size: 32rpx; line-height: 1; }
.itinerary-action-mask { position: fixed; z-index: 10; top: 0; right: 0; bottom: 0; left: 0; background: transparent; }
