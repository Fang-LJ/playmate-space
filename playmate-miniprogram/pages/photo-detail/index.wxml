<view class="page photo-detail-page">
  <view wx:if="{{loading}}" class="card state-card">正在加载照片…</view><view wx:elif="{{error}}" class="card state-card"><view>{{error}}</view><view class="pm-button-like secondary retry" bindtap="load">重新加载</view></view>
  <block wx:else>
    <view class="detail-image-wrap"><image src="{{photo.previewUrl}}" mode="aspectFit" class="detail-image"/><view class="detail-status {{photo.statusMeta.className}}">{{photo.statusMeta.text}}</view></view>
    <view class="card uploader-card"><image wx:if="{{photo.uploaderAvatarUrl}}" src="{{photo.uploaderAvatarUrl}}" mode="aspectFill" class="uploader-avatar"/><view wx:else class="uploader-avatar placeholder">{{photo.avatarText}}</view><view class="uploader-copy"><view class="uploader-name">{{photo.uploaderNickname||'玩伴用户'}}</view><view class="muted">{{photo.uploadTimeText}} 上传</view></view></view>
    <view class="card info-card"><view class="section-title">照片信息</view><view class="info-row"><text>尺寸</text><text>{{photo.dimensionsText}}</text></view><view class="info-row"><text>原图大小</text><text>{{photo.sizeText}}</text></view><view class="info-row"><text>文件类型</text><text>{{photo.contentTypeText}}</text></view><view class="info-row"><text>审核状态</text><text class="status-text {{photo.statusMeta.className}}">{{photo.statusMeta.text}}</text></view></view>
    <view class="detail-actions"><view class="pm-button-like secondary" bindtap="toggleLike">{{photo.likedByMe?'♥ 已点赞':'♡ 点赞'}} {{photo.likeCount||0}}</view><view class="pm-button-like primary" bindtap="viewOriginal">查看原图</view><view class="pm-button-like secondary more-button" bindtap="openMore">更多</view></view>
  </block>
  <view wx:if="{{moreVisible}}" class="sheet-mask" bindtap="closeMore"><view class="action-sheet" catchtap="stop"><view class="sheet-handle"></view><view class="sheet-title">更多操作</view><view class="action-line" bindtap="openReport">举报照片</view><view wx:if="{{photo.canDelete}}" class="action-line danger" bindtap="confirmDelete">删除照片</view><view class="pm-button-like secondary close-action" bindtap="closeMore">取消</view></view></view>
  <view wx:if="{{reportVisible}}" class="sheet-mask" bindtap="closeReport"><view class="action-sheet" catchtap="stop"><view class="sheet-handle"></view><view class="sheet-title">举报照片</view><view class="sheet-desc">请选择举报原因</view><view wx:for="{{reasons}}" wx:key="code" class="action-line" data-reason="{{item.code}}" bindtap="submitReport">{{item.label}}</view></view></view>
</view>
