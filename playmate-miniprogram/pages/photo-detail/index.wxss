.photo-detail-page { padding-bottom:60rpx; }.state-card { margin-top:24rpx; text-align:center; }.retry { width:220rpx; margin:24rpx auto 0; }.detail-image-wrap { position:relative; display:flex; align-items:center; justify-content:center; min-height:520rpx; margin-top:16rpx; overflow:hidden; border-radius:30rpx; background:#e8efea; }.detail-image { width:100%; height:560rpx; }.detail-status { position:absolute; top:20rpx; right:20rpx; padding:10rpx 16rpx; border-radius:999rpx; background:var(--pm-primary-light); color:var(--pm-primary-dark); font-size:22rpx; font-weight:800; }.detail-status.pending,.detail-status.reviewing { background:var(--pm-warning-soft); color:#8a6500; }.detail-status.rejected { background:var(--pm-danger-soft); color:var(--pm-danger); }.uploader-card { display:flex; align-items:center; gap:18rpx; margin-top:24rpx; padding:26rpx; }.uploader-avatar { flex:0 0 64rpx; width:64rpx; height:64rpx; border-radius:50%; background:var(--pm-primary-light); }.placeholder { display:flex; align-items:center; justify-content:center; color:var(--pm-primary-dark); font-size:27rpx; font-weight:800; }.uploader-copy { min-width:0; }.uploader-name { color:var(--pm-text); font-size:29rpx; font-weight:800; }.detail-actions { display:flex; gap:14rpx; margin-top:22rpx; }.detail-actions .pm-button-like { flex:1; padding:0 12rpx; font-size:23rpx; }.more-button { flex:0 0 82rpx!important; }.info-card { margin-top:20rpx; }.photo-tech-line { margin-top:14rpx; color:var(--pm-text-muted); font-size:25rpx; }.status-text { display:inline-block; margin-top:18rpx; color:var(--pm-primary-dark); font-size:25rpx; font-weight:800; }.status-text.pending,.status-text.reviewing { color:#8a6500!important; }.status-text.rejected { color:var(--pm-danger)!important; }.status-description { margin-top:10rpx; color:var(--pm-text-muted); font-size:23rpx; line-height:1.5; }.sheet-mask { position:fixed; z-index:30; inset:0; background:rgba(21,31,25,.46); }.action-sheet { position:absolute; right:0; bottom:0; left:0; padding:18rpx 32rpx calc(34rpx + env(safe-area-inset-bottom)); border-radius:30rpx 30rpx 0 0; background:#fff; }.sheet-handle { width:64rpx; height:7rpx; margin:0 auto 20rpx; border-radius:999rpx; background:#dce5df; }.sheet-title { color:var(--pm-text); font-size:33rpx; font-weight:900; }.sheet-desc { margin-top:10rpx; color:var(--pm-text-muted); font-size:24rpx; }.action-line { min-height:84rpx; padding:0 4rpx; border-bottom:1rpx solid var(--pm-border); color:var(--pm-text); font-size:27rpx; font-weight:700; line-height:84rpx; }.action-line.danger { color:var(--pm-danger); }.close-action { margin-top:22rpx; }
